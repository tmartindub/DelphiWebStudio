        <VerInfo_Keys>FileVersion=1.0.0.1;ProductVersion=1.0.0.1;FileDescription=Delphi Web Studio Pro;InternalName=DelphiWebStudioPro;OriginalFilename=DelphiWebStudioPro.exe;ProductName=Delphi Web Studio Pro</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <BT_BuildType>Release</BT_BuildType>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <Icon_MainIcon>..\..\images and icons\DelphiWebStudio-app-icon.ico</Icon_MainIcon>
