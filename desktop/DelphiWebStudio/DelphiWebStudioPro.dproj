    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>DelphiWebStudioPro</SanitizedProjectName>
        <DCC_ExeOutput>..\..\bin\$(Platform)</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\dcu\$(Platform)</DCC_DcuOutput>
